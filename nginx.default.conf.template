# Processado pelo Nginx na subida do container: ${API_UPSTREAM} é trocado
# pelo valor da variável de ambiente de mesmo nome. As variáveis do próprio
# Nginx ($uri, $host, ...) não usam chaves e passam intactas.
server {
    listen 80;
    server_name _;

    root /usr/share/nginx/html;
    index index.html;

    # Resolver interno do Docker: permite subir mesmo que a API ainda
    # não esteja no ar, e resolve o nome do serviço em tempo de requisição.
    resolver 127.0.0.11 valid=10s ipv6=off;

    gzip on;
    gzip_types text/css application/javascript application/json image/svg+xml;

    # SPA: qualquer rota do React Router cai no index.html
    location / {
        try_files $uri $uri/ /index.html;
    }

    # Assets com hash no nome podem ser cacheados agressivamente
    location /assets/ {
        expires 1y;
        add_header Cache-Control "public, immutable";
    }

    # Proxy para a API da Fase 2 — evita CORS por manter a mesma origem
    location /api/ {
        set $api ${API_UPSTREAM};
        proxy_pass $api/;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}
