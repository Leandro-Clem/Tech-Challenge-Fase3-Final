# URL base da API.
# Deixe em "/api" para usar o proxy do Vite (dev) ou do Nginx (Docker).
# Use a URL completa (ex.: http://localhost:3000) apenas se o back-end
# estiver com CORS habilitado.
VITE_API_URL=/api

# Destino do proxy em desenvolvimento
VITE_PROXY_TARGET=http://localhost:3000

# Caminho da pasta do back-end da Fase 2, usado pelo docker compose.
# Aceita caminho relativo a esta pasta ou absoluto.
BACKEND_PATH=../Tech-Challenge-Fase2-Final
